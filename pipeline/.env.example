# ============================================================================
#  数据处理管线的数据库连接配置（模板）
#  用法：复制本文件为 .env（去掉 .example 后缀），改成自己的密码
#  .env 已被 .gitignore 排除，不会提交到仓库
# ============================================================================

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=floodgis
PGUSER=postgres
PGPASSWORD=在这里填你的密码
