<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
   城市内涝风险可视化平台 · 后端工程描述文件（Maven 的"施工图纸"）
  ============================================================================
   Maven 只认这个文件：它告诉 Maven 四件事
     1. 我是谁            -> groupId / artifactId / version
     2. 我继承谁          -> parent（Spring Boot 官方帮我们管好所有 jar 的版本）
     3. 我需要哪些 jar    -> dependencies
     4. 怎么打包成可运行  -> build / spring-boot-maven-plugin
   改完这个文件，IDEA 右上角会出现一个刷新图标（Load Maven Changes），点一下才会生效
  ============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
      parent：继承 spring-boot-starter-parent。
      这一步是整个 pom 里最省事的地方——继承之后，下面所有依赖都不用写版本号，
      Spring Boot 已经替我们测过“哪几个版本配在一起不会打架”。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/> <!-- 留空表示去中央仓库找，不要找上一级目录 -->
    </parent>

    <!-- 三个坐标唯一确定一个工程，将来装到本地仓库时靠它定位 -->
    <groupId>com.floodgis</groupId>
    <artifactId>floodgis-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>floodgis-backend</name>
    <description>城市内涝风险可视化平台 - 后端服务</description>

    <properties>
        <!-- 编译用 Java 21。本机 JDK 就是 21，数字必须对得上，否则 IDEA 会报 release version 错误 -->
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>

        <!-- ① Web 能力：内嵌 Tomcat + Spring MVC + Jackson(JSON 序列化)
             有了它，@RestController / @GetMapping 这些注解才生效 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ② 数据库访问：提供 JdbcTemplate（手写 SQL 的工具）
             比 JPA 更直白，适合我们这种“SQL 里全是 PostGIS 函数”的场景 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- ③ PostgreSQL 驱动：Java 能连上 PostgreSQL 全靠它
             scope=runtime 表示编译时用不到、跑起来才需要（我们代码里不会 import 它的类） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ④ 开发期热重启：改完 Java 代码，不用手动点重启，3 秒内自动生效
             optional=true 表示打包给别人用时不会带上它 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- ⑤ 测试：JUnit 5 + Spring 测试容器，第一周还用不到，先留着 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
              这个插件负责把工程打成“一个可以直接 java -jar 跑起来的胖 jar”，
              它会把所有依赖一起塞进去。将来上线就靠它。
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <!--
      ========================================================================
       演示打包专用 profile：把已经构建好的前端产物塞进 jar
      ========================================================================
      为什么要做这件事？

      演示机上不允许再装 Node / 起 Vite。我们希望的最终形态是
      “一个 jar + 一个 bat，双击就跑”。Spring Boot 内嵌的 Tomcat 本身就能
      提供静态文件：它默认把 classpath 下的 /static/ 目录当作静态资源根，
      也就是 jar 里的 BOOT-INF/classes/static/。
      所以只要把 frontend/dist 的内容复制到 target/classes/static，
      前端就变成了 jar 的一部分——启动顺序、跨域、端口全都不需要再操心。

      为什么用 copy-resources 而不是 frontend-maven-plugin 去跑 npm？
      因为演示机没有 Node，打包只在开发机上做一次。把“构建前端”和“打包后端”
      分成两步（先 npm run build，再 mvn package），出错时更容易定位是哪一步的问题。

      为什么必须放在 profile 里，而不是直接写进 <build><plugins>？

      copy-resources 在源目录不存在时会直接让构建失败。
      没跑过 npm run build 的人（比如刚 clone 仓库的同事、CI 上的单元测试流水线）
      执行 mvn package 就会挂在一个和 Java 毫无关系的错误上。
      用 <activation><file> 按“frontend/dist/index.html 是否存在”自动开关，
      行为就变成：
        · dist 在   -> 打进 jar，得到一个自包含的演示包
        · dist 不在 -> 只打后端，构建照常成功，零影响
      这个 profile 不需要 -P 手动指定，Maven 自己判断。

      一个必须知道的副作用：copy-resources 只覆盖同名文件，不删除 target 里
      多出来的旧文件。所以 frontend/dist 里删掉的东西会残留，下次打 jar 又被带上。
      真实踩过：时间轴的帧从 7 个 png 换成 153 个 webp 后，旧 png 仍留在 jar 里。
      打演示包时请用 mvn clean package（scripts/build-demo.bat 已经是这么做的）。
      ========================================================================
    -->
    <profiles>
        <profile>
            <id>with-frontend</id>
            <activation>
                <file>
                    <!-- 用 index.html 作为“前端构建完成”的标志，比判断目录更可靠：
                         空目录也可能被 IDE 或空跑的命令意外创建出来 -->
                    <exists>${project.basedir}/../frontend/dist/index.html</exists>
                </file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <!-- process-resources 在 compile 之前，
                                     保证后面打 jar 时 target/classes/static 已经就位 -->
                                <id>copy-frontend-dist</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}/../frontend/dist</directory>
                                            <!-- 连空目录一起复制，Cesium 的 Worker/Assets 里有层级较深
                                                 的空目录；不复制会让某些运行时路径 404 -->
                                            <filtering>false</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
