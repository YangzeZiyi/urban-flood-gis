<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
   城市内涝风险可视化平台 · 后端工程描述文件（Maven 的"施工图纸"）
  ============================================================================
   Maven 只认这个文件：它告诉 Maven 四件事
     1. 我是谁            -> groupId / artifactId / version
     2. 我继承谁          -> parent（Spring Boot 官方帮我们管好所有 jar 的版本）
     3. 我需要哪些 jar    -> dependencies
     4. 怎么打包成可运行  -> build / spring-boot-maven-plugin
   改完这个文件，IDEA 右上角会出现一个刷新图标（Load Maven Changes），点一下才会生效
  ============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
      parent：继承 spring-boot-starter-parent。
      这一步是整个 pom 里最省事的地方——继承之后，下面所有依赖都不用写版本号，
      Spring Boot 已经替我们测过“哪几个版本配在一起不会打架”。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/> <!-- 留空表示去中央仓库找，不要找上一级目录 -->
    </parent>

    <!-- 三个坐标唯一确定一个工程，将来装到本地仓库时靠它定位 -->
    <groupId>com.floodgis</groupId>
    <artifactId>floodgis-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>floodgis-backend</name>
    <description>城市内涝风险可视化平台 - 后端服务</description>

    <properties>
        <!-- 编译用 Java 21。本机 JDK 就是 21，数字必须对得上，否则 IDEA 会报 release version 错误 -->
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>

        <!-- ① Web 能力：内嵌 Tomcat + Spring MVC + Jackson(JSON 序列化)
             有了它，@RestController / @GetMapping 这些注解才生效 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ② 数据库访问：提供 JdbcTemplate（手写 SQL 的工具）
             比 JPA 更直白，适合我们这种“SQL 里全是 PostGIS 函数”的场景 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- ③ PostgreSQL 驱动：Java 能连上 PostgreSQL 全靠它
             scope=runtime 表示编译时用不到、跑起来才需要（我们代码里不会 import 它的类） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ④ 开发期热重启：改完 Java 代码，不用手动点重启，3 秒内自动生效
             optional=true 表示打包给别人用时不会带上它 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- ⑤ 测试：JUnit 5 + Spring 测试容器，第一周还用不到，先留着 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
              这个插件负责把工程打成“一个可以直接 java -jar 跑起来的胖 jar”，
              它会把所有依赖一起塞进去。将来上线就靠它。
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
