# ============================================================================
#  静态数据版（`npm run build:static`）
# ----------------------------------------------------------------------------
#  这个模式没有任何后端进程，也没有数据库。打包出来的 dist/ 直接丢给任意
#  静态服务器就能跑：易涝点和边界是 GeoJSON，单点查询按 0.1° 分块读 .bin，
#  框选统计在浏览器里按 12 角秒降采样网格算。
#
#  数据由 pipeline/publish/export_static.py 生成，放在 public/static-data/。
#
#  注意：Vite 会同时加载 .env（所有模式）和 .env.static（仅 --mode static），
#  同名变量以 .env.static 为准。所以这里只写和默认模式不同的那一项。
# ============================================================================

VITE_STATIC_DATA=1
